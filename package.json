{
    "name": "hello_world",
    "version": "1.0.0",
    "description": "Express.js web server with greeting endpoints, demonstrating routing and API implementation. Test project for backprop integration.",
    "keywords": [
        "express",
        "nodejs",
        "api",
        "rest",
        "web-server",
        "backprop"
    ],
    "homepage": "https://github.com/sudhanshu-spec/test-spec#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/sudhanshu-spec/test-spec.git"
    },
    "bugs": {
        "url": "https://github.com/sudhanshu-spec/test-spec/issues"
    },
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "test": "jest --detectOpenHandles --forceExit",
        "test:unit": "jest tests/unit --detectOpenHandles --forceExit",
        "test:security": "jest tests/security --detectOpenHandles --forceExit",
        "test:coverage": "jest --coverage --detectOpenHandles --forceExit"
    },
    "author": "hxu",
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=7.0.0"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "express": "^5.2.0",
        "express-rate-limit": "^8.2.1",
        "express-validator": "^7.2.0",
        "helmet": "^8.1.0"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "supertest": "^7.1.4"
    },
    "jest": {
        "testMatch": ["**/tests/**/*.js", "**/test_*.js"],
        "testPathIgnorePatterns": ["/node_modules/", "/tests/helpers/", "/tests/fixtures/"],
        "testEnvironment": "node",
        "verbose": true
    }
}
