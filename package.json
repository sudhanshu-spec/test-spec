{
    "name": "hello_world",
    "version": "1.0.0",
    "description": "Hello world in Node.js",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:ci": "jest --ci --coverage --reporters=default",
        "test:client": "cd client && npm test",
        "test:all": "npm test && npm run test:client",
        "test:client:coverage": "cd client && npm run test:coverage",
        "coverage:all": "npm run test:coverage && npm run test:client:coverage"
    },
    "author": "hxu",
    "license": "MIT",
    "dependencies": {
        "express": "^5.1.0"
    },
    "devDependencies": {
        "jest": "^30.2.0",
        "supertest": "^7.1.4"
    }
}
