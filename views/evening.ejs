<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>Hello World App</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/evening.css">
</head>
<body class="evening-theme">
  <%- include('partials/header') %>
  <main class="main-content">
    <div class="greeting-container">
      <h1 class="greeting-text"><%= greeting %></h1>
      <p class="greeting-subtitle">Enjoy the peaceful evening hours!</p>
      <div class="stars-decoration" aria-hidden="true">
        <span class="star">★</span>
        <span class="star">★</span>
        <span class="star">★</span>
      </div>
    </div>
  </main>
  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
