# =============================================================================
# Environment Configuration Template
# =============================================================================
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# All variables have sensible defaults defined in src/config/index.js.
# The application will start successfully without a .env file present.
# Environment variables set in the system/shell take precedence over .env values.
#
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Server binding address
# Use 127.0.0.1 for local-only access or 0.0.0.0 to listen on all interfaces
HOST=127.0.0.1

# Server binding port number
# Must be a valid integer; commonly 3000 for development, 80/8080 for production
PORT=3000

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------

# Application environment identifier
# Valid values: development, production, test
# Controls behavior such as error stack trace visibility and log formatting
NODE_ENV=development

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Winston logging level (npm log level convention)
# Valid values (in order of priority): error, warn, info, http, verbose, debug, silly
# Messages at the configured level and above will be output
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------

# Allowed origin(s) for cross-origin requests
# Use * to allow all origins (development default)
# Use a specific origin URL for production (e.g., https://example.com)
CORS_ORIGIN=*
