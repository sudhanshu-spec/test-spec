# =============================================================================
# Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your local environment.
# The application works without a .env file using the defaults below.
# =============================================================================

# Server Configuration
HOST=127.0.0.1          # Server binding address (use 0.0.0.0 for all interfaces)
PORT=3000               # Server binding port number
NODE_ENV=development    # Application environment (development, production, test)

# Logging Configuration
LOG_LEVEL=info          # Winston log level (error, warn, info, http, verbose, debug, silly)
APP_NAME=hello_world    # Application name used in log entries

# CORS Configuration
CORS_ORIGIN=*           # Allowed CORS origin(s) (* for all, or specific URL)
