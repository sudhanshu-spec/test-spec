# ============================================================================
# Environment Configuration Template
# ============================================================================
#
# This file serves as a template for environment variables used by the
# application. It follows the Twelve-Factor App methodology for configuration
# externalization.
#
# USAGE:
# 1. Copy this file to .env for local development:
#    cp .env.example .env
#
# 2. Modify values in .env as needed for your environment
#
# 3. IMPORTANT: Never commit .env files with secrets to version control!
#    The .env file is already included in .gitignore
#
# FORMAT: VARIABLE=default_value # Description
#
# ============================================================================

# ============================================================================
# Server Configuration
# ============================================================================
# These settings control the HTTP server binding and application environment

# Server binding address
# Use 127.0.0.1 for local development (default)
# Use 0.0.0.0 for external access (required for Docker/production)
HOST=127.0.0.1

# Server binding port
# Default: 3000
PORT=3000

# Application environment
# Options: development, staging, production, test
# - development: Verbose logging, detailed error messages
# - staging: Production-like settings for testing
# - production: Optimized for production deployment
# - test: Minimal logging for test runs
NODE_ENV=development

# ============================================================================
# Logging Configuration
# ============================================================================
# These settings control application and HTTP request logging behavior

# Log level threshold
# Options (in order of priority): error, warn, info, http, debug
# - error: Only log errors
# - warn: Log warnings and errors
# - info: Log general info, warnings, and errors (recommended for production)
# - http: Log HTTP requests plus all above
# - debug: Log everything including debug info (recommended for development)
LOG_LEVEL=info

# Morgan HTTP request log format
# Options: combined, common, dev, short, tiny
# - combined: Apache combined log format (recommended for production)
# - common: Apache common log format
# - dev: Colorized output for development (recommended for development)
# - short: Shorter than default, includes response time
# - tiny: Minimal output
LOG_FORMAT=combined

# ============================================================================
# Security Configuration
# ============================================================================
# These settings control security-related middleware behavior

# CORS (Cross-Origin Resource Sharing) allowed origins
# Use '*' to allow all origins (suitable for development/public APIs)
# Use specific domain(s) in production for security
# Examples:
#   Single origin: https://example.com
#   Multiple origins: https://example.com,https://app.example.com
CORS_ORIGIN=*

# ============================================================================
# PM2 Configuration
# ============================================================================
# These settings control PM2 process manager behavior in production

# Number of cluster instances to spawn
# 0 = Auto-detect based on available CPU cores (recommended for production)
# 1 = Single instance (fork mode)
# N = Specific number of instances
PM2_INSTANCES=0

# ============================================================================
# Future/Optional Configuration
# ============================================================================
# These variables are available for future features or integrations
# Uncomment and configure as needed

# Database Configuration (for future database integration)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=app_database
# DB_USER=app_user
# DB_PASSWORD=

# API Authentication (for authenticated service integration)
# API_KEY=

# Rate Limiting (for future rate limiting implementation)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration (for future session support)
# SESSION_SECRET=
# SESSION_MAX_AGE=86400000
