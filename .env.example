# =============================================================================
# Environment Configuration Template for Security-Hardened Express Application
# =============================================================================
# 
# USAGE:
# 1. Copy this file to .env in your project root: cp .env.example .env
# 2. Customize the values for your environment
# 3. Never commit .env to version control (it should be in .gitignore)
#
# All variables have sensible defaults for development. For production,
# review and adjust each setting according to your security requirements.
# =============================================================================

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing.
# In production, explicitly list all domains that should have access.
# Set to empty or omit to block all cross-origin requests (most secure).
#
# Examples:
#   Single origin:    ALLOWED_ORIGINS=https://myapp.com
#   Multiple origins: ALLOWED_ORIGINS=https://myapp.com,https://admin.myapp.com
#   Development:      ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
#
# Security Note: Never use wildcard (*) in production environments.
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
# Protects against brute-force attacks and denial-of-service attempts.
# These settings apply per IP address.
#
# RATE_LIMIT_WINDOW_MS: Time window in milliseconds for rate limiting
#   Default: 900000 (15 minutes)
#   Range: 60000 (1 min) to 3600000 (1 hour) recommended
#
# RATE_LIMIT_MAX: Maximum number of requests per window per IP
#   Default: 100 requests per 15 minutes
#   Adjust based on expected legitimate traffic patterns
#
# Security Note: Lower values are more secure but may impact legitimate users.
# Monitor 429 responses in production to fine-tune these values.
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# HTTPS/TLS Configuration
# -----------------------------------------------------------------------------
# Enable HTTPS for encrypted communications. Required for production.
#
# HTTPS_ENABLED: Toggle HTTPS server
#   Values: true | false
#   Default: false (for development convenience)
#   Production: Should always be true
#
# HTTPS_PORT: Port for HTTPS server
#   Default: 3443
#   Production: Typically 443 (requires root/sudo or port forwarding)
#
# SSL_KEY_PATH: Path to TLS private key file (PEM format)
#   Default: ./certs/key.pem
#   Security Note: Ensure file permissions are 600 (owner read/write only)
#
# SSL_CERT_PATH: Path to TLS certificate file (PEM format)
#   Default: ./certs/cert.pem
#   For production, use certificates from a trusted CA (e.g., Let's Encrypt)
#
# Certificate Generation for Development:
#   openssl req -x509 -newkey rsa:4096 -keyout certs/key.pem \
#     -out certs/cert.pem -days 365 -nodes -subj "/CN=localhost"
# -----------------------------------------------------------------------------
HTTPS_ENABLED=false
HTTPS_PORT=3443
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
# NODE_ENV: Determines environment-specific behavior
#   Values: development | production | test
#
#   development:
#     - More verbose logging
#     - Relaxed CSP for debugging tools
#     - Higher rate limits for testing
#     - HTTPS optional
#
#   production:
#     - Strict Content Security Policy
#     - Full security headers enabled
#     - HSTS (HTTP Strict Transport Security) active
#     - Lower, enforced rate limits
#     - HTTPS strongly recommended
#
#   test:
#     - Suitable for automated testing
#     - May disable certain middleware for testing isolation
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# PORT: HTTP server port
#   Default: 3000
#   Note: The application also supports this for backward compatibility
#
# HOST: Server binding address
#   Default: 127.0.0.1 (localhost only - secure for development)
#   Production: 0.0.0.0 (all interfaces) if behind reverse proxy
#   Security Note: Only bind to 0.0.0.0 when properly firewalled
# -----------------------------------------------------------------------------
PORT=3000
HOST=127.0.0.1

# -----------------------------------------------------------------------------
# Redis Configuration (Optional - For Distributed Rate Limiting)
# -----------------------------------------------------------------------------
# When deploying multiple instances, use Redis for shared rate limit state.
# If not configured, falls back to in-memory store (single instance only).
#
# REDIS_URL: Full Redis connection URL
#   Format: redis://[username:password@]host:port[/database]
#   Example: redis://localhost:6379
#   Example with auth: redis://default:password@redis.example.com:6379/0
#
# Uncomment and configure for distributed deployments:
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Security Headers Configuration (Advanced)
# -----------------------------------------------------------------------------
# These optional settings allow fine-tuning of security headers.
# Most applications should use the defaults provided by helmet.js.
#
# CSP_REPORT_URI: URL to receive Content-Security-Policy violation reports
#   Example: https://myapp.com/csp-report
#   Note: Useful for monitoring and debugging CSP issues
#
# HSTS_MAX_AGE: HTTP Strict Transport Security max-age in seconds
#   Default: 31536000 (1 year)
#   Minimum recommended: 15768000 (6 months)
#
# Uncomment and configure as needed:
# -----------------------------------------------------------------------------
# CSP_REPORT_URI=
# HSTS_MAX_AGE=31536000

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Configuration for structured logging using Pino logger.
# Logs are essential for debugging, monitoring, and security auditing.
#
# LOG_LEVEL: Controls logging verbosity
#   Values: trace | debug | info | warn | error | fatal
#   Default: info
#   
#   Level hierarchy (from most to least verbose):
#     trace  - Extremely detailed tracing information
#     debug  - Debugging information useful during development
#     info   - General operational information (recommended for production)
#     warn   - Warning messages for potentially harmful situations
#     error  - Error events that might still allow the app to continue
#     fatal  - Severe errors that cause the application to abort
#
#   Development: Use 'debug' or 'trace' for detailed output
#   Production:  Use 'info' or 'warn' to reduce log volume
#
# LOG_FORMAT: Output format for log messages
#   Values: json | pretty
#   Default: json
#
#   json   - Machine-parseable JSON format (recommended for production)
#            Best for log aggregation tools (ELK, CloudWatch, Datadog)
#   pretty - Human-readable colored output (recommended for development)
#            Uses pino-pretty for formatting
#
# LOG_REDACT_PATHS: JSON paths to redact from logs for sensitive data
#   Format: JSON array of path strings
#   Default: ["req.headers.authorization"]
#   
#   Examples:
#     Basic:    ["req.headers.authorization"]
#     Extended: ["req.headers.authorization","req.body.password","req.body.token"]
#
#   Security Note: Always redact sensitive data like:
#     - Authorization headers (tokens, API keys)
#     - Passwords and credentials
#     - Personal identifiable information (PII)
#     - Credit card numbers or financial data
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
LOG_REDACT_PATHS=["req.headers.authorization"]

# -----------------------------------------------------------------------------
# PM2 Process Manager Configuration
# -----------------------------------------------------------------------------
# PM2 is used for production deployment with clustering, load balancing,
# and automatic restarts. These settings configure the ecosystem.config.js.
#
# PM2_INSTANCES: Number of application instances to run
#   Values: number | 'max'
#   Default: max
#   
#   'max' - Spawns one instance per available CPU core (recommended)
#   number - Specific number of instances (e.g., 4)
#   
#   Development: Use 1 for single instance
#   Production:  Use 'max' to utilize all CPU cores
#
#   Note: Cluster mode enables zero-downtime deployments via pm2 reload
#
# PM2_EXEC_MODE: Process execution mode
#   Values: cluster | fork
#   Default: cluster
#   
#   cluster - Enables Node.js cluster mode with built-in load balancer
#             Recommended for production multi-core CPU utilization
#             Supports zero-downtime reloads
#   
#   fork    - Standard child process fork mode
#             Useful for development or when clustering is not needed
#             Each instance runs completely independently
#
#   Security Note: In cluster mode, all workers share the same port,
#   and PM2 handles load balancing automatically.
# -----------------------------------------------------------------------------
PM2_INSTANCES=max
PM2_EXEC_MODE=cluster

# -----------------------------------------------------------------------------
# Health Check Configuration
# -----------------------------------------------------------------------------
# Health check endpoints for load balancer and container orchestration
# integration (Kubernetes, Docker Swarm, AWS ELB, etc.).
#
# HEALTH_CHECK_PATH: Liveness probe endpoint path
#   Default: /health
#   
#   Used to determine if the application is running.
#   Returns 200 OK with status information when healthy.
#   
#   Response format: { "status": "healthy", "timestamp": "...", "uptime": ... }
#
# READY_CHECK_PATH: Readiness probe endpoint path
#   Default: /ready
#   
#   Used to determine if the application is ready to receive traffic.
#   Checks internal dependencies and returns 200 OK when ready.
#   Returns 503 Service Unavailable when not ready.
#   
#   Response format: { "status": "ready", "timestamp": "...", "checks": {...} }
#
# Usage with Kubernetes:
#   livenessProbe:
#     httpGet:
#       path: /health
#       port: 3000
#   readinessProbe:
#     httpGet:
#       path: /ready
#       port: 3000
#
# Security Note: Health endpoints expose minimal information to avoid
# leaking sensitive details about application internals.
# -----------------------------------------------------------------------------
HEALTH_CHECK_PATH=/health
READY_CHECK_PATH=/ready

# -----------------------------------------------------------------------------
# Graceful Shutdown Configuration
# -----------------------------------------------------------------------------
# Controls how the application handles shutdown signals (SIGTERM, SIGINT).
# Essential for zero-downtime deployments and proper resource cleanup.
#
# SHUTDOWN_TIMEOUT: Maximum time to wait for graceful shutdown (milliseconds)
#   Default: 10000 (10 seconds)
#   Range: 1000 (1 second) to 30000 (30 seconds) recommended
#
#   During graceful shutdown:
#     1. Stop accepting new connections
#     2. Wait for existing requests to complete
#     3. Close database connections and cleanup resources
#     4. Exit process cleanly
#
#   If shutdown exceeds this timeout, the process will force exit.
#
#   Development: 5000 (5 seconds) for faster restarts
#   Production:  10000-30000 (10-30 seconds) to allow long-running requests
#
#   Note: This should align with your load balancer's drain timeout and
#   PM2's kill_timeout configuration in ecosystem.config.js
# -----------------------------------------------------------------------------
SHUTDOWN_TIMEOUT=10000

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
# 
# For more information about security configuration, refer to:
# - Express.js Security Best Practices: https://expressjs.com/en/advanced/best-practice-security.html
# - helmet.js Documentation: https://helmetjs.github.io/
# - OWASP Secure Headers: https://owasp.org/www-project-secure-headers/
# - Node.js TLS Documentation: https://nodejs.org/api/tls.html
#
# For logging and process management, refer to:
# - Pino Logger Documentation: https://getpino.io/
# - PM2 Documentation: https://pm2.keymetrics.io/docs/usage/quick-start/
# =============================================================================
