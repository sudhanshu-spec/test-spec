# =============================================================================
# Environment Configuration Template
# =============================================================================
#
# This file documents all environment variables used by the application.
# Copy this file to .env for local development:
#
#   cp .env.example .env
#
# Then modify values in .env as needed for your local environment.
# The .env file is excluded from version control via .gitignore.
#
# All variables have sensible defaults defined in src/config/index.js,
# so the application will start without a .env file present.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Host address the server binds to.
# Default: 127.0.0.1 (localhost only; use 0.0.0.0 to accept external connections)
HOST=127.0.0.1

# Port number the server listens on.
# Default: 3000
PORT=3000

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------

# Application environment mode.
# Accepted values: development, production, test
# Default: development
NODE_ENV=development

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Winston logger severity level.
# Accepted values (in order of priority): error, warn, info, http, debug
# Default: info
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------

# Allowed origin(s) for Cross-Origin Resource Sharing.
# Use '*' to allow all origins, or specify a domain (e.g., https://example.com).
# Default: * (all origins)
CORS_ORIGIN=*
