# =============================================================================
# Environment Variables Template
# =============================================================================
#
# This file serves as a template and documentation for all configurable
# environment variables in this application. Copy this file to .env for
# local development configuration.
#
# IMPORTANT: Never commit your .env file to version control!
# The .env file should remain in .gitignore to protect sensitive data.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your local configuration
#
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# HOST - The host address to bind the server to
# Default: 127.0.0.1
#
# Options:
#   - 127.0.0.1 : Localhost only (recommended for local development)
#   - 0.0.0.0   : All network interfaces (required for production/containers)
#
# Security Note: Using 127.0.0.1 restricts access to the local machine only,
# providing an additional layer of security during development.
# In production behind a reverse proxy (nginx, load balancer), 0.0.0.0 is safe.
#
HOST=127.0.0.1

# PORT - The port number for the server to listen on
# Default: 3000
#
# Note: Ports below 1024 require root/admin privileges on most systems.
# In containerized environments, this may be overridden by the orchestrator.
#
# Production Recommendation: Use the default or let the platform assign
# the port via environment variable (e.g., Heroku, Cloud Run).
#
PORT=3000

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------

# NODE_ENV - The application runtime environment
# Default: development
#
# Options:
#   - development : Verbose logging, detailed error messages, debugging enabled
#   - production  : Optimized performance, minimal logging, errors sanitized
#   - test        : Testing configuration, isolated from dev/prod
#
# Security Note: NEVER run production servers with NODE_ENV=development
# as it may expose sensitive stack traces and debugging information.
#
# Production Recommendation: Always set to 'production' in deployed environments.
#
NODE_ENV=development

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# LOG_LEVEL - Controls the verbosity of application logging
# Default: debug
#
# Log Levels (from most to least verbose):
#   - debug : Detailed debugging information (development only)
#   - http  : HTTP request/response logging
#   - info  : General operational information
#   - warn  : Warning messages for potential issues
#   - error : Error conditions only
#
# Production Recommendation: Use 'info' or 'warn' to reduce log volume
# and improve performance. Use 'error' for high-traffic production systems
# where disk I/O from logging could impact performance.
#
# Security Note: Debug level may log sensitive request data. Avoid in production.
#
LOG_LEVEL=debug

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
#
# For PM2 deployment configuration, see ecosystem.config.js
# For additional documentation, see README.md
#
# =============================================================================
