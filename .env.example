# Environment Variable Template
# Purpose: Configuration template for hao-backprop-test Express.js server
# Usage: Copy this file to .env and customize values for your local environment

# JWT Secret Key for Token Signing and Verification
# Format: String, minimum 32 characters recommended for security
# Security: Generate a strong random string for production - never commit actual secrets to version control
JWT_SECRET=your-secure-jwt-secret-key-here

# Server Listening Port
# Format: Integer, valid port range 1024-65535
# Note: Optional - if not specified, server defaults to port 3000
PORT=3000

# Application Environment Mode
# Format: String - valid values are: development, production, test
# Note: Affects logging verbosity and error handling behavior
NODE_ENV=development

# =============================================================================
# Security Configuration
# Purpose: Security middleware settings for production-grade protection
# Reference: OWASP Top 10 security guidelines compliance
# =============================================================================

# CORS (Cross-Origin Resource Sharing) Allowed Origins
# Format: String - single origin URL or comma-separated list of allowed origins
# Purpose: Controls which domains can make cross-origin requests to your API
# Default: http://localhost:3000
# Examples:
#   - Single origin: https://example.com
#   - Multiple origins: https://app.example.com,https://admin.example.com
#   - Allow all (NOT recommended for production): *
CORS_ORIGIN=http://localhost:3000

# Rate Limiting Window Duration
# Format: Integer - time window in milliseconds
# Purpose: Defines the time period over which request counts are tracked per IP
# Default: 900000 (15 minutes)
# Note: Shorter windows provide stricter rate limiting but may affect legitimate users
# Examples:
#   - 1 minute: 60000
#   - 5 minutes: 300000
#   - 15 minutes: 900000 (recommended)
#   - 1 hour: 3600000
RATE_LIMIT_WINDOW_MS=900000

# Rate Limiting Maximum Requests
# Format: Integer - maximum number of requests allowed per window per IP
# Purpose: Prevents DoS attacks and brute force attempts by limiting request frequency
# Default: 100
# Note: Adjust based on your application's expected traffic patterns
# Security: Lower values provide stronger protection but may impact legitimate API consumers
RATE_LIMIT_MAX=100

# HTTPS Server Enable Flag
# Format: Boolean - 'true' or 'false'
# Purpose: Enables HTTPS/TLS encrypted server instead of plain HTTP
# Default: false
# Note: Requires SSL_KEY_PATH and SSL_CERT_PATH to be configured when enabled
# Security: Always enable in production for encrypted data transmission
ENABLE_HTTPS=false

# SSL Private Key File Path
# Format: String - absolute or relative path to PEM-encoded private key file
# Purpose: Private key for TLS/SSL certificate authentication
# Default: (empty - not required when ENABLE_HTTPS=false)
# Required: Only when ENABLE_HTTPS=true
# Example: ./certs/server.key or /etc/ssl/private/server.key
# Security: Ensure file has restricted permissions (chmod 600) and is not committed to version control
SSL_KEY_PATH=

# SSL Certificate File Path
# Format: String - absolute or relative path to PEM-encoded certificate file
# Purpose: Public certificate for TLS/SSL encryption
# Default: (empty - not required when ENABLE_HTTPS=false)
# Required: Only when ENABLE_HTTPS=true
# Example: ./certs/server.crt or /etc/ssl/certs/server.crt
# Note: Include full certificate chain if using intermediate certificates
SSL_CERT_PATH=

# Trust Proxy Headers Flag
# Format: Boolean - 'true' or 'false'
# Purpose: Trust X-Forwarded-* headers from reverse proxy (nginx, load balancer, etc.)
# Default: false
# Note: Enable when running behind a reverse proxy to get correct client IP addresses
# Security: Only enable if you trust your proxy; incorrect settings can allow IP spoofing
# Use cases:
#   - Behind nginx/Apache reverse proxy: true
#   - Behind AWS ELB/ALB: true
#   - Direct internet exposure: false
TRUST_PROXY=false
