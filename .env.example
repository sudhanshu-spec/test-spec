# Server Configuration
# ====================
# Copy this file to .env and modify as needed for your environment.
# All variables are optional - defaults are used when not specified.
#
# For more information on configuration options, see src/config/index.js

# ------------------------------------------------------------------------------
# Server Host Binding Address
# ------------------------------------------------------------------------------
# Specifies the network interface the server binds to.
#
# Default: 127.0.0.1 (localhost only - rejects external connections)
# Use 0.0.0.0 to accept connections from any network interface (required for
# Docker containers or when accepting external connections in production).
#
# Security Note: Only bind to 0.0.0.0 in trusted network environments or
# behind a reverse proxy (nginx, HAProxy, etc.)
HOST=127.0.0.1

# ------------------------------------------------------------------------------
# Server Port Number
# ------------------------------------------------------------------------------
# The port number the HTTP server listens on.
#
# Default: 3000
# Common alternatives: 8080, 8000, 80 (requires root/elevated privileges)
#
# Note: Value is parsed as an integer. Invalid values fall back to default.
PORT=3000

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
# Sets the runtime environment mode affecting logging, error handling,
# and other environment-specific behaviors.
#
# Valid values:
#   - development : Verbose logging, detailed error messages (default)
#   - production  : Optimized performance, minimal logging
#   - test        : Used during automated testing
#
# Default: development
NODE_ENV=development
