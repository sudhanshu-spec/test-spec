# ==============================================================================
# Environment Configuration Template
# ==============================================================================
#
# This file serves as a template for the .env configuration file.
# Copy this file to .env and customize the values for your local environment:
#
#   cp .env.example .env
#
# The .env file is excluded from version control via .gitignore to prevent
# accidental exposure of sensitive configuration values.
#
# All variables listed here are loaded by the dotenv package at application
# startup and consumed by the configuration module (src/config/index.js).
# Default values shown below match the application's built-in defaults.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------

# Host address the server binds to.
# Use 127.0.0.1 for local-only access or 0.0.0.0 to accept external connections.
# Default: 127.0.0.1
HOST=127.0.0.1

# Port number the server listens on.
# Must be a valid integer between 1 and 65535.
# Default: 3000
PORT=3000

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------

# Application runtime environment.
# Valid values: development, production, test
# Controls behavior such as error verbosity, log formatting, and middleware
# configuration (e.g., Morgan log format, Winston console colorization).
# Default: development
NODE_ENV=development

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------

# Winston logger severity level.
# Valid values (in order of priority): error, warn, info, http, verbose, debug, silly
# In production, 'info' or 'warn' is recommended to reduce log volume.
# In development, 'debug' provides detailed diagnostic output.
# Default: info
LOG_LEVEL=info
