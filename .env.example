# =============================================================================
# Environment Configuration Template
# =============================================================================
# This file documents all environment variables used by the application.
# Copy this file to .env and customize values for your environment.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your local settings
#
# IMPORTANT: Never commit .env files to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# The port number on which the Express server will listen for incoming requests.
# In production, this is typically set by the hosting platform or load balancer.
#
# Type: Integer
# Required: No
# Default: 3000
# Example values: 3000, 8080, 8000
PORT=3000

# -----------------------------------------------------------------------------
# Environment Mode
# -----------------------------------------------------------------------------
# Determines the application's running environment, affecting behavior such as
# error verbosity, logging format, and performance optimizations.
#
# Type: String
# Required: No
# Default: development
# Allowed values:
#   - development : Verbose logging, detailed error messages, no caching
#   - production  : JSON logging, minimal error details, optimized performance
#   - test        : Configuration for automated testing
#
# Production considerations:
#   - Always set to 'production' in production environments
#   - Enables response compression
#   - Reduces error detail exposure for security
NODE_ENV=development

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# LOG_LEVEL: Controls the minimum severity level for log output.
# Messages below this level will be filtered out.
#
# Type: String
# Required: No
# Default: info
# Allowed values (in order of severity, highest to lowest):
#   - error : Only critical errors that require immediate attention
#   - warn  : Warning messages and errors
#   - info  : Informational messages, warnings, and errors (recommended for production)
#   - http  : HTTP request logs, info, warnings, and errors
#   - debug : Detailed debug information (not recommended for production)
#
# Production recommendation: 'info' or 'warn'
# Development recommendation: 'debug' or 'http'
LOG_LEVEL=info

# LOG_DIR: Directory path where log files will be stored.
# The application will create this directory if it doesn't exist.
# Both absolute and relative paths are supported.
#
# Type: String (path)
# Required: No
# Default: ./logs
# Example values: ./logs, /var/log/app, ../logs
#
# Note: Ensure the application has write permissions to this directory.
# In containerized environments, consider using a mounted volume.
LOG_DIR=./logs

# =============================================================================
# Additional Configuration (Optional)
# =============================================================================
# The following variables are not required but may be useful for extended
# functionality in future implementations.
# -----------------------------------------------------------------------------

# HOST: The hostname or IP address to bind the server to.
# Use 0.0.0.0 to accept connections from any network interface.
#
# Type: String (hostname/IP)
# Required: No
# Default: 0.0.0.0
# Example values: localhost, 127.0.0.1, 0.0.0.0
# HOST=0.0.0.0

# =============================================================================
# Environment-Specific Examples
# =============================================================================
#
# Development Environment:
#   PORT=3000
#   NODE_ENV=development
#   LOG_LEVEL=debug
#   LOG_DIR=./logs
#
# Production Environment:
#   PORT=3000
#   NODE_ENV=production
#   LOG_LEVEL=info
#   LOG_DIR=/var/log/hello-world
#
# Testing Environment:
#   PORT=3001
#   NODE_ENV=test
#   LOG_LEVEL=error
#   LOG_DIR=./test-logs
#
# =============================================================================
