# =============================================================================
# Environment Configuration Template
# =============================================================================
#
# This file documents all supported environment variables for the Hello World
# Express application. Copy this file to .env and customize values for your
# environment.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   npm start
#
# Following the Twelve-Factor App methodology for configuration externalization.
# https://12factor.net/config
#
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Server binding address
# Use '127.0.0.1' for localhost only (default, more secure for development)
# Use '0.0.0.0' to accept connections from all network interfaces (production)
HOST=127.0.0.1

# Server port number
# The port on which the HTTP server will listen for incoming requests
# Default: 3000
PORT=3000

# Application environment
# Determines application behavior, logging verbosity, and error detail exposure
# Valid values: development, production, test
# - development: Verbose logging, detailed error messages, debug features enabled
# - production: Minimal logging, generic error messages, optimized performance
# - test: Silent logging, suitable for automated test runs
NODE_ENV=development

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Winston logging level
# Controls the minimum severity level of messages that are logged
# Levels in order of severity (highest to lowest):
#   error > warn > info > http > verbose > debug > silly
# Default: 'info' in production, 'debug' in development
# Recommended:
#   - Production: info (logs info, warn, and error)
#   - Development: debug (logs all levels including debug)
#   - Debugging issues: debug or verbose
LOG_LEVEL=info

# Morgan HTTP request log format
# Determines the format of HTTP request logs
# Available formats:
#   - combined: Apache combined log format (recommended for production)
#   - common: Apache common log format
#   - dev: Concise colored output for development
#   - short: Shorter than default, includes response time
#   - tiny: Minimal output
# Default: combined
# Recommended:
#   - Production: combined (comprehensive logs for analysis)
#   - Development: dev (colored, readable output)
LOG_FORMAT=combined

# =============================================================================
# End of Configuration
# =============================================================================
