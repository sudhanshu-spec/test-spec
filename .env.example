# =============================================================================
# Environment Configuration Template
# =============================================================================
# This file serves as documentation for all required environment variables.
# Copy this file to .env and configure values for your specific environment.
#
# IMPORTANT: Never commit your actual .env file to version control!
# The .env file should contain sensitive values and be listed in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Controls the application runtime environment and server ports.
# NODE_ENV affects security middleware behavior and error handling.
# - 'development': Verbose error messages, relaxed security for local testing
# - 'production': Secure defaults, sanitized error responses, strict security
# -----------------------------------------------------------------------------

# Application environment mode (development, production, test)
NODE_ENV=development

# HTTP server port - the port where the Express application listens
PORT=3000

# HTTPS server port - the port for secure TLS/SSL connections
# Standard HTTPS port is 443 (requires root privileges on Unix systems)
# Use 8443 for non-privileged development environments
HTTPS_PORT=443

# -----------------------------------------------------------------------------
# SSL/TLS Configuration (for HTTPS Support)
# -----------------------------------------------------------------------------
# Paths to SSL certificate files for enabling HTTPS.
# Required for production deployments to encrypt client-server communication.
#
# For development: Generate self-signed certificates using:
#   openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
#     -keyout certs/server.key -out certs/server.cert -subj "/CN=localhost"
#
# For production: Use certificates from a trusted Certificate Authority (CA)
# such as Let's Encrypt, DigiCert, or your organization's CA.
# -----------------------------------------------------------------------------

# Path to the SSL private key file (PEM format)
SSL_KEY_PATH=./certs/server.key

# Path to the SSL certificate file (PEM format)
SSL_CERT_PATH=./certs/server.cert

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing) Configuration
# -----------------------------------------------------------------------------
# Controls which external domains can make requests to this API.
# This is a critical security setting to prevent unauthorized cross-origin access.
#
# SECURITY WARNING: Never use '*' (wildcard) in production!
# Always explicitly whitelist trusted origins.
#
# Format: Comma-separated list of allowed origins (no spaces)
# Example: https://example.com,https://app.example.com,https://admin.example.com
# -----------------------------------------------------------------------------

# Comma-separated list of allowed origins for CORS requests
# For development, localhost origins are typically sufficient
# For production, list all trusted frontend domains
ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
# Protects against brute force attacks, API abuse, and denial-of-service (DoS).
# Limits the number of requests a single IP address can make within a time window.
#
# Adjust these values based on your application's expected traffic patterns:
# - Higher limits for public APIs with legitimate high-frequency users
# - Lower limits for sensitive endpoints (login, password reset)
# -----------------------------------------------------------------------------

# Time window for rate limiting in milliseconds
# Default: 900000 (15 minutes)
# Common values:
#   - 60000 (1 minute) for strict limiting
#   - 900000 (15 minutes) for moderate limiting
#   - 3600000 (1 hour) for relaxed limiting
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests allowed per IP within the time window
# Default: 100 requests per window
# Adjust based on expected legitimate usage patterns
# Lower values (10-50) for sensitive endpoints
# Higher values (100-1000) for general API endpoints
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# Additional Security Notes
# =============================================================================
#
# 1. HTTPS in Production:
#    Always enable HTTPS in production environments. HTTP should only be used
#    for local development or when behind a TLS-terminating reverse proxy.
#
# 2. Environment-Specific Configuration:
#    Create separate .env files for each environment:
#    - .env.development (local development)
#    - .env.test (test environment)
#    - .env.production (production environment)
#
# 3. Secret Management:
#    For production deployments, consider using a secrets management service
#    (AWS Secrets Manager, HashiCorp Vault, etc.) instead of .env files.
#
# 4. Certificate Renewal:
#    SSL certificates expire. Set up automated renewal (e.g., certbot for
#    Let's Encrypt) to avoid service disruption.
#
# 5. Monitoring:
#    Monitor rate limit hits and CORS violations in production to identify
#    potential attacks or misconfigured clients.
#
# =============================================================================
