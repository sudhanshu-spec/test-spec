# ==============================================
# Application Environment Configuration
# ==============================================
# Copy this file to .env and modify as needed
# Do not commit .env to version control
#
# This file documents all environment variables used by the application
# following the Twelve-Factor App methodology for configuration externalization.
# See: https://12factor.net/config

# ==============================================
# Server Configuration
# ==============================================

# Server bind address
# The IP address the server will listen on
# Default: 127.0.0.1 (localhost only)
# Use 0.0.0.0 to accept connections from any network interface
HOST=127.0.0.1

# Server port number
# The port the HTTP server will listen on
# Default: 3000
PORT=3000

# Application environment
# Controls application behavior and logging verbosity
# Valid options: development, production, test
# Default: development
NODE_ENV=development

# ==============================================
# Logging Configuration
# ==============================================

# Log level
# Controls the minimum severity of messages that are logged
# Valid options: error, warn, info, debug
# - error: Only log errors (most restrictive)
# - warn: Log warnings and errors
# - info: Log informational messages, warnings, and errors (recommended for production)
# - debug: Log all messages including debug information (most verbose)
# Default: info
LOG_LEVEL=info

# Request log format
# Controls the format of HTTP request logs (morgan format)
# Valid options: combined, common, dev, short, tiny
# - combined: Standard Apache combined log format (recommended for production)
# - common: Standard Apache common log format
# - dev: Concise colored output for development
# - short: Shorter than default, includes response time
# - tiny: Minimal output
# Default: combined
LOG_FORMAT=combined

# ==============================================
# Security Configuration
# ==============================================

# Rate limiting - Time window in milliseconds
# The time frame for which requests are tracked
# Default: 900000 (15 minutes)
# Example: 60000 = 1 minute, 3600000 = 1 hour
RATE_LIMIT_WINDOW_MS=900000

# Rate limiting - Maximum requests per window
# Maximum number of requests allowed per IP within the time window
# Default: 100
# Adjust based on expected traffic patterns and API usage
RATE_LIMIT_MAX=100

# CORS - Allowed origins
# Controls which domains can make cross-origin requests to this server
# Options:
# - * : Allow all origins (use with caution in production)
# - Single origin: https://example.com
# - Multiple origins: https://example.com,https://api.example.com
# Default: * (all origins allowed)
CORS_ORIGIN=*
