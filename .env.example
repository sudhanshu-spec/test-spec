# Hello World Express Server - Environment Configuration
# Copy this file to .env and adjust values as needed
# Do NOT commit your .env file to version control

# =============================================================================
# Server Configuration
# =============================================================================

# Server host binding address
# Use '127.0.0.1' for localhost only
# Use '0.0.0.0' to listen on all network interfaces
HOST=127.0.0.1

# Server port number
# Default: 3000
PORT=3000

# Application environment
# Options: development, production, test
# Affects logging verbosity and error message detail
NODE_ENV=development

# =============================================================================
# Logging Configuration
# =============================================================================

# Winston logging level
# Options: error, warn, info, http, verbose, debug, silly
# Default: 'info' in production, 'debug' in development
LOG_LEVEL=debug

# Morgan HTTP request log format
# Options: combined, dev, common, short, tiny
# Default: 'combined'
# 'dev' is recommended for development (colorized, concise)
# 'combined' is recommended for production (Apache combined format)
LOG_FORMAT=dev
