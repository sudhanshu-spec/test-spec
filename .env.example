# =============================================================================
# Environment Configuration Template
# =============================================================================
# 
# This file documents all available environment variables for the Express.js
# application. Copy this file to .env and customize values for your environment.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#
# Note: Never commit your actual .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Server host binding address
# The IP address the server will bind to for incoming connections.
# Use '127.0.0.1' for local development (localhost only)
# Use '0.0.0.0' for production to accept connections from any interface
# Default: 127.0.0.1
HOST=127.0.0.1

# Server port number
# The port number the HTTP server will listen on.
# Default: 3000
PORT=3000

# Application environment
# Controls application behavior (logging, caching, error display)
# Valid values: development, production, test
# - development: Verbose logging, no template caching, detailed errors
# - production: Minimal logging, template caching enabled, generic errors
# - test: Used for running automated tests
# Default: development
NODE_ENV=development

# -----------------------------------------------------------------------------
# UI Configuration
# -----------------------------------------------------------------------------

# Views directory path
# Path to the directory containing EJS template files for server-side rendering.
# Relative to the project root or an absolute path.
# Default: ./views
VIEWS_DIR=./views

# Public assets directory path
# Path to the directory containing static assets (CSS, JavaScript, images).
# Files in this directory are served directly by Express static middleware.
# Relative to the project root or an absolute path.
# Default: ./public
PUBLIC_DIR=./public
