# =============================================================================
# Environment Variable Template
# =============================================================================
# Copy this file to .env and adjust the values to match your local environment:
#
#   cp .env.example .env
#
# The .env file is loaded by dotenv in src/server.js at application startup.
# All variables are consumed exclusively through src/config/index.js — never
# access process.env directly in other modules.
#
# IMPORTANT: Never commit your .env file to version control. It is excluded
# via .gitignore. This .env.example template IS safe for version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Port number on which the Express HTTP server will listen.
# Default: 3000
PORT=3000

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------

# Determines runtime behaviour such as logging format, error verbosity, and
# middleware settings. Accepted values: development | production | test
# Default: development
NODE_ENV=development

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Controls the minimum severity level written to log outputs (console and file).
# Winston log levels in order of priority:
#   error (0) | warn (1) | info (2) | http (3) | debug (4)
# In production, "info" or "warn" is recommended. Use "debug" during local
# development for maximum visibility.
# Default: debug
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------

# Origin(s) permitted to make cross-origin requests to this server.
# Use '*' to allow all origins during development. In production, set this to
# the specific domain(s) that should have access (e.g., https://example.com).
# Default: *
CORS_ORIGIN=*
