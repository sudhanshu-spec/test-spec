# =============================================================================
# Environment Configuration Template
# =============================================================================
# 
# This file documents all environment variables used by the application.
# Copy this file to .env and customize values for your environment.
#
# IMPORTANT: Never commit .env files with real values to version control.
#            This .env.example file serves as documentation only.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your environment-specific values
#
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# These settings control the basic server behavior and binding.

# Server host binding address
# - Use '127.0.0.1' for localhost-only access (default, more secure)
# - Use '0.0.0.0' to accept connections from any network interface
# Default: 127.0.0.1
HOST=127.0.0.1

# Server port number
# - Standard HTTP port is 80, HTTPS is 443 (requires elevated privileges)
# - Development typically uses ports above 1024 (no special privileges needed)
# Default: 3000
PORT=3000

# Application environment
# - 'development': Enables verbose logging, relaxed security settings
# - 'production': Enables strict security settings, optimized performance
# - 'test': Used during automated testing
# Default: development
NODE_ENV=development

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# These settings control the security middleware behavior.
# Adjust these values based on your deployment environment.

# -----------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing) Configuration
# -----------------------------------------------------------------------------

# Allowed CORS origins
# - '*' allows requests from any origin (suitable for development/public APIs)
# - Comma-separated list of allowed origins for production
# - Use specific domains in production for enhanced security
#
# Examples:
#   Development: CORS_ORIGIN=*
#   Production:  CORS_ORIGIN=https://yourdomain.com
#   Multiple:    CORS_ORIGIN=https://app.example.com,https://admin.example.com
#
# Default: * (all origins allowed)
# Production Recommendation: https://yourdomain.com (restrict to known origins)
CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------

# Rate limit time window in milliseconds
# - Defines the duration for counting requests per IP address
# - After this window expires, the request count resets
#
# Common values:
#   60000    = 1 minute
#   300000   = 5 minutes
#   900000   = 15 minutes (default)
#   3600000  = 1 hour
#
# Default: 900000 (15 minutes)
# Production Recommendation: 900000 (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per IP within the time window
# - Requests exceeding this limit receive HTTP 429 (Too Many Requests)
# - Higher values for development allow easier testing
# - Lower values for production protect against abuse
#
# Common values:
#   Development: 1000 (allows rapid testing without hitting limits)
#   Production:  100 (standard protection against abuse)
#   Strict:      50 (enhanced protection for sensitive endpoints)
#
# Default: 100
# Development Recommendation: 1000
# Production Recommendation: 100
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# Proxy Configuration
# -----------------------------------------------------------------------------

# Trust proxy setting for rate limiting and IP detection
# - Set to 'true' when running behind a reverse proxy (nginx, AWS ALB, etc.)
# - When true, X-Forwarded-For header is used to determine client IP
# - When false, the direct connection IP is used
#
# IMPORTANT: Only enable this when you trust your proxy configuration.
#            Enabling this on a server directly exposed to the internet
#            allows IP spoofing via X-Forwarded-For header.
#
# Default: false
# Production Recommendation: true (when behind a trusted reverse proxy/load balancer)
TRUST_PROXY=false

# =============================================================================
# ENVIRONMENT PROFILES
# =============================================================================
#
# Development Profile (copy these values for local development):
#   HOST=127.0.0.1
#   PORT=3000
#   NODE_ENV=development
#   CORS_ORIGIN=*
#   RATE_LIMIT_WINDOW_MS=900000
#   RATE_LIMIT_MAX=1000
#   TRUST_PROXY=false
#
# Production Profile (recommended values for production deployment):
#   HOST=0.0.0.0
#   PORT=3000
#   NODE_ENV=production
#   CORS_ORIGIN=https://yourdomain.com
#   RATE_LIMIT_WINDOW_MS=900000
#   RATE_LIMIT_MAX=100
#   TRUST_PROXY=true
#
# =============================================================================
