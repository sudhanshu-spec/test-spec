# =============================================================================
# Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your environment:
#   cp .env.example .env
#
# IMPORTANT: Never commit the .env file to version control.
# Only this .env.example template should be tracked in git.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Server host binding address
# The IP address or hostname the server binds to.
# Valid values: Any valid IPv4 address or hostname (e.g., 0.0.0.0, 127.0.0.1, localhost)
# Default: 127.0.0.1
HOST=127.0.0.1

# Server port number
# The TCP port the server listens on.
# Valid values: Any available port number between 1 and 65535
# Default: 3000
PORT=3000

# Application environment
# Determines runtime behavior such as logging verbosity, error detail exposure,
# and Morgan log format (dev vs combined).
# Valid values: development, production, test
# Default: development
NODE_ENV=development

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Winston logger log level
# Controls the minimum severity of messages written to log transports.
# Valid values (from highest to lowest severity): error, warn, info, http, verbose, debug, silly
# Default: info
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------

# Allowed CORS origin
# Specifies which origins are permitted to make cross-origin requests.
# Valid values: * (allow all origins), a specific origin URL (e.g., https://example.com),
#   or a comma-separated list of origins
# Default: * (all origins allowed)
CORS_ORIGIN=*
