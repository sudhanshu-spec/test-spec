# =============================================================================
# Environment Configuration Template
# =============================================================================
# This file documents all available environment variables for the application.
# Copy this file to .env and modify values as needed for your environment.
#
# IMPORTANT: Never commit your actual .env file to version control!
# =============================================================================

# =============================================================================
# Server Configuration
# =============================================================================
# These settings control the basic server binding and operation mode.

# Server host binding address
# Use 127.0.0.1 for local-only access, 0.0.0.0 for all interfaces
# Default: 127.0.0.1
HOST=127.0.0.1

# Server port number
# Ensure this port is available and not blocked by firewall
# Default: 3000
PORT=3000

# Application environment
# Values: development, production, test
# - development: Relaxed security settings, verbose logging
# - production: Strict security, optimized performance
# - test: Used during automated testing
# Default: development
NODE_ENV=development

# =============================================================================
# Rate Limiting Configuration
# =============================================================================
# Protects against denial-of-service (DoS) attacks by limiting request frequency.
# These settings apply per IP address.

# Rate limit window duration in milliseconds
# Default: 900000 (15 minutes)
# Production recommendation: 900000 (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests allowed per window per IP address
# Default: 100
# Development: Consider using 200 for more relaxed testing
# Production: 100 is recommended for API endpoints
RATE_LIMIT_MAX=100

# =============================================================================
# CORS (Cross-Origin Resource Sharing) Configuration
# =============================================================================
# Controls which domains can make requests to this API.
# SECURITY: Configure carefully in production to prevent unauthorized access.

# Comma-separated list of allowed origins
# Use * for all origins (development only - NOT recommended for production)
# Examples:
#   - Single origin: https://myapp.com
#   - Multiple origins: https://myapp.com,https://admin.myapp.com
#   - All origins (dev only): *
# Default: * (all origins allowed)
# Production: Specify exact allowed origins
CORS_ALLOWED_ORIGINS=*

# =============================================================================
# HTTPS/SSL Configuration
# =============================================================================
# Enables encrypted communication via TLS/SSL.
# SECURITY: Always enable HTTPS in production environments.
#
# NOTE: SSL certificate files should NEVER be committed to version control.
# Add certificate paths to .gitignore and manage certificates securely.

# Enable HTTPS server
# Values: true, false
# Default: false
# Production: true (recommended - use reverse proxy like nginx for TLS termination)
HTTPS_ENABLED=false

# Path to SSL private key file
# Only required when HTTPS_ENABLED=true
# Example: ./certs/server.key or /etc/ssl/private/server.key
# Default: ./certs/server.key
# SECURITY: Keep private key file permissions restricted (chmod 600)
SSL_KEY_PATH=./certs/server.key

# Path to SSL certificate file
# Only required when HTTPS_ENABLED=true
# Example: ./certs/server.cert or /etc/ssl/certs/server.crt
# Default: ./certs/server.cert
SSL_CERT_PATH=./certs/server.cert

# =============================================================================
# Environment-Specific Recommendations
# =============================================================================
#
# DEVELOPMENT:
#   NODE_ENV=development
#   RATE_LIMIT_MAX=200 (more relaxed for testing)
#   CORS_ALLOWED_ORIGINS=*
#   HTTPS_ENABLED=false
#
# PRODUCTION:
#   NODE_ENV=production
#   RATE_LIMIT_WINDOW_MS=900000
#   RATE_LIMIT_MAX=100
#   CORS_ALLOWED_ORIGINS=https://yourdomain.com
#   HTTPS_ENABLED=true (or use reverse proxy for TLS)
#   SSL_KEY_PATH=/path/to/production/key
#   SSL_CERT_PATH=/path/to/production/cert
#
# TESTING:
#   NODE_ENV=test
#   RATE_LIMIT_MAX=1000 (disable effective rate limiting)
#   CORS_ALLOWED_ORIGINS=*
#   HTTPS_ENABLED=false
#
# =============================================================================
