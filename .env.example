# =============================================================================
# Environment Configuration Template
# =============================================================================
# 
# This file documents all available environment variables for the application.
# Copy this file to .env for local development:
#   cp .env.example .env
#
# This configuration follows the Twelve-Factor App methodology for environment-
# based configuration externalization.
#
# IMPORTANT: Never commit your .env file to version control as it may contain
# sensitive information.
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Server host binding address
# The IP address the server will bind to
# Use '0.0.0.0' to allow external connections
# Default: 127.0.0.1 (localhost only)
HOST=127.0.0.1

# Server port number
# The port the HTTP server will listen on
# Must be a valid port number (1-65535)
# Default: 3000
PORT=3000

# Application environment
# Determines environment-specific behavior (logging verbosity, error details)
# Valid values: development, production, test
# Default: development
NODE_ENV=development

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Log level for Winston logger
# Controls the verbosity of application logging
# Valid values: error, warn, info, http, verbose, debug, silly
# Default: info (production), debug (development)
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------

# Rate limit time window in milliseconds
# The time window during which requests are counted
# Default: 900000 (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests per window
# The maximum number of requests allowed from a single IP within the window
# Default: 100
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# Compression Configuration
# -----------------------------------------------------------------------------

# Minimum response size threshold for compression (in bytes)
# Responses smaller than this value will not be compressed
# Set to 0 to compress all responses
# Default: 1024 (1KB)
COMPRESSION_THRESHOLD=1024

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------

# Allowed CORS origin(s)
# The origin(s) allowed to make cross-origin requests
# Use '*' to allow all origins (not recommended for production)
# Use comma-separated values for multiple origins: https://example.com,https://app.example.com
# Default: * (all origins allowed)
CORS_ORIGIN=*
